// Cloudflare : le site statique de site/ (données comprises) et un petit Worker pour le compteur de
// visites (/api/*), qui garde un seul nombre dans une base D1. Le Worker passe en premier sur toutes
// les adresses : il pose le mot de passe de l'aperçu privé (voir worker/index.js). Publication :
//   npx wrangler deploy
{
  "name": "wikimap",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wikimap",
      "database_id": "ac0fa7dd-789b-4a61-b1f9-6df707172ff4"
    }
  ]
}
